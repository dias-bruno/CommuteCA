Package: CommuteCA
Title: Standardized Methods for Accessibility Analysis in Canadian Research
Version: 3.4
Authors@R: 
    c(person("Bruno", "Dos Santos", , "dossanb@mcmaster.ca", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-6748-2038")),
           person("Antonio", "Paez", , "paezha@mcmaster.ca", role = c("aut"),
